{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "challenges",
    "verificationRequests",
    "recommendations",
    "practiceProfile"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "challengeId",
          "claimId",
          "assessment",
          "issue",
          "resolution",
          "disposition"
        ],
        "properties": {
          "challengeId": {
            "type": "string"
          },
          "claimId": {
            "type": "string"
          },
          "assessment": {
            "type": "string",
            "enum": ["uphold", "qualify", "reject"]
          },
          "issue": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          },
          "disposition": {
            "type": "string",
            "enum": ["upheld", "qualified", "rejected", "unresolved"]
          }
        }
      }
    },
    "verificationRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claimId", "preferredMethod", "rationale", "checks"],
        "properties": {
          "claimId": {
            "type": "string"
          },
          "preferredMethod": {
            "type": "string",
            "enum": ["static_inspection", "executable_probe"]
          },
          "rationale": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "title",
          "problem",
          "change",
          "repositoryChanges",
          "claimIds",
          "practiceIds",
          "affectedDimensions",
          "tokenMechanism",
          "validationChecks",
          "limitations",
          "effort"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "title": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "change": {
            "type": "string"
          },
          "repositoryChanges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "claimIds": {
            "type": "array",
            "minItems": 1,
            "description": "IDs of supplied atomic repository-navigation fact claims only. Probe results and feature behavior are validator evidence, never recommendation evidence.",
            "items": {
              "type": "string"
            }
          },
          "practiceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["01", "02", "03", "04", "05", "06", "07"]
            }
          },
          "affectedDimensions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "discoveryEfficiency",
                "ownershipClarity",
                "dependencyClarity",
                "changeSurfaceRecall",
                "verificationDiscoverability",
                "instructionQuality"
              ]
            }
          },
          "tokenMechanism": {
            "type": "string"
          },
          "validationChecks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effort": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "practiceProfile": {
      "type": "array",
      "description": "Exactly seven ordered items in general mode; an empty array in task-specific and system-explanation modes.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "practiceId",
          "status",
          "assessment",
          "tokenImpact",
          "claimIds",
          "recommendationIds",
          "limitations"
        ],
        "properties": {
          "practiceId": {
            "type": "string",
            "enum": ["01", "02", "03", "04", "05", "06", "07"]
          },
          "status": {
            "type": "string",
            "enum": ["strong", "mixed", "weak", "not_assessed"]
          },
          "assessment": {
            "type": "string"
          },
          "tokenImpact": {
            "type": "string"
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendationIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
